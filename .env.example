# SQLite database — reuses the existing file at the repo root.
# Both `sqlite:<path>` (sqlx style) and `sqlite://<path>` are accepted; the
# scheme is stripped by the app (see src/db/index.ts).
DATABASE_URL=sqlite:korucha-fund.db

# Admin basic-auth credentials (protects /admin and admin APIs).
# Quote values containing '#' or other special chars — the env parser treats
# an unquoted '#' as the start of an inline comment and would truncate it.
ADMIN_USER=admin
ADMIN_PASS="change-me"

# Server port.
PORT=3000

# Daily batch schedule — node-cron, 6-field (sec min hour dom mon dow), JST.
SCHEDULER_CRON="0 0 23 * * *"
